{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], /* Добавлено DOM.Iterable для корректной работы переборов в React */
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true, /* РЕКОМЕНДУЕТСЯ: включает полную строгую проверку типов */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true, /* Убедитесь, что TS версии 5.5+ */
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"] /* Добавлен конфигурационный файл Vite */
}
